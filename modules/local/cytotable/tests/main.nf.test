nextflow_process {

    name "Test Process CYTOTABLE"
    script "../main.nf"
    process "CYTOTABLE"

    test("Should run without failures") {

        when {
            params {
                // define parameters here.
            }
            process {
                """
                input[0] = [
                    [batch: '2021_04_26_Batch1', plate: 'BR00117035'],
                    [
                        file("s3://nf-core-test-datasets/cellpainting/minimal_dataset/cpg0016-jump/source_4/workspace/analysis/2021_04_26_Batch1/BR00117035/analysis/BR00117035-A01-1/")
                    ]
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.parquet.size() > 0 }
            )
        }

    }

    test("cytotable - stats JSON structure") {

        when {
            params {
                // define parameters here.
            }
            process {
                """
                input[0] = [
                    [batch: '2021_04_26_Batch1', plate: 'BR00117035'],
                    [
                        file("s3://nf-core-test-datasets/cellpainting/minimal_dataset/cpg0016-jump/source_4/workspace/analysis/2021_04_26_Batch1/BR00117035/analysis/BR00117035-A01-1/")
                    ]
                ]
                """
            }
        }

        then {
            def stats = new groovy.json.JsonSlurper().parse(path(process.out.stats[0][1]).toFile())
            assertAll(
                { assert process.success },
                { assert stats.num_rows > 0 },
                { assert stats.num_columns > 0 },
                { assert stats.num_cells == stats.num_rows },
                { assert stats.compartment_columns instanceof Map },
                { ['Cells', 'Cytoplasm', 'Nuclei', 'Metadata'].each { prefix -> assert stats.compartment_columns[prefix] > 0 } }
            )
        }

    }

    test("cytotable - stub") {
        tag "stub"
        options "-stub"
        when {
            process {
                """
                def analysisDir1 = file("${workDir}/analysis_1")
                analysisDir1.mkdirs()
                file("${workDir}/analysis_1/Image.csv").text = "ImageNumber"

                def analysisDir2 = file("${workDir}/analysis_2")
                analysisDir2.mkdirs()
                file("${workDir}/analysis_2/Image.csv").text = "ImageNumber"

                input[0] = [
                    [batch: '2021_04_26_Batch1', plate: 'BR00117035'],
                    [analysisDir1, analysisDir2]
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.parquet).match() }
            )
        }
    }

}
