nextflow_process {

    name "Test Process CYTOTABLE_REPORTS"
    script "../main.nf"
    process "CYTOTABLE_REPORTS"

    tag "modules"
    tag "modules_local"
    tag "reports"
    tag "reports/cytotable"

    test("cytotable reports - runs with local fixture") {
        // Self-contained fixture so the test does not depend on S3 or a
        // preceding CYTOTABLE run.
        when {
            process {
                """
                input[0] = [
                    [batch: '2021_04_26_Batch1', plate: 'BR00117035'],
                    file("${projectDir}/tests/fixtures/profiles_fixture.parquet", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert process.out.metadata.size() > 0 },
                { assert path(process.out.metadata[0][1]).toFile().length() > 0 },
                {
                    def meta = path(process.out.metadata[0][1].toString()).json
                    assert meta.dataframe_overview.n_rows == 12
                    assert meta.dataframe_overview.n_columns == 9
                    assert meta.file_info.filename == 'profiles_fixture.parquet'
                    assert meta.metadata_columns.count > 0
                    assert !meta.metadata_columns.columns.isEmpty()
                    assert !meta.column_structure.isEmpty()
                },
                { assert process.out.stats.size() > 0 },
                { assert path(process.out.stats[0][1]).toFile().length() > 0 },
                { assert process.out.html.size() > 0 },
                { assert process.out.plots.size() == 1 },
                { assert process.out.plots[0][1].size() == 2 },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("cytotable reports - stub") {
        tag "stub"
        options "-stub"
        when {
            process {
                """
                input[0] = [
                    [batch: '2021_04_26_Batch1', plate: 'BR00117035'],
                    file("${projectDir}/tests/fixtures/profiles_fixture.parquet", checkIfExists: true)
                ]
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out.metadata, process.out.stats, process.out.html, process.out.plots).match() }
            )
        }
    }
}
